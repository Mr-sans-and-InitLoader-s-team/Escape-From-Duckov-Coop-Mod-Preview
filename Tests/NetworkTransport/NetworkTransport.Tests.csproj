<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LiteNetLib" HintPath="../../Shared/LiteNetLib.dll" Private="true" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(DUCKOV_GAME_MANAGED)/com.rlabrecque.steamworks.net.dll" Private="true" />
    <Compile Include="../../EscapeFromDuckovModApi/Networking/CoopPeer.cs" Link="Source/CoopPeer.cs" />
    <Compile Include="../../EscapeFromDuckovModApi/Networking/CoopPacketReader.cs" Link="Source/CoopPacketReader.cs" />
    <Compile Include="../../EscapeFromDuckovCoopMod/Net/Transport/**/*.cs" Link="Source/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
